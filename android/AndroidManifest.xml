<?xml version="1.0" encoding="utf-8"?>
<!--
  YanSaki的小屋 · Android 封装版

  ⚠ minSdk 选 29（Android 10）是**故意的**，不是偷懒：
    产品里的「导出」走 `URL.createObjectURL(blob)` + `<a download>`，封装版要把文件
    落到「下载」目录。API 29 起有 MediaStore.Downloads，**零运行时权限**；
    29 以下只能写 /sdcard/Download，得再申请 WRITE_EXTERNAL_STORAGE、
    还得处理用户拒绝 —— 多两条失败路径，换来的只是 Android 9 及更早的机器。
    2026 年了，这笔账不划算。要兼容 29 以下再说。

  ⚠ targetSdk 34：Play 商店的硬要求，且 34 会强制 `android:exported` 显式声明。

  ⚠⚠ 版本号与 Release tag **必须对得上**：tag `apk-v1.3` ⇔ versionName `1.3`。
    versionCode 只要求**单调递增**，装新包时系统靠它判断是升级。
    ⚠ 2026-09-30「清空重来」：versionCode 由 2 退回 1、versionName 由 1.2 退回 1.0
      （用户指定「回归到 1.0」），并把旧的 v1.0 / v1.1 / v1.2 三个 release 与 tag 一并删除
      ⇒ **`apk-v1.0` 这个名字被复用，与 09-30 之前那个同名包不是一回事**
      （那个是 debug 签名的、只有 1 083 285 字节）。
    ⚠⚠ 2026-09-30 换图标那一版**直接跳到 1.3，跳过了 1.1 / 1.2** —— 不是笔误：
      `apk-v1.1` / `apk-v1.2` 这两个名字**已经用过一次**（同上面 v1.0 的情况），
      复用它们等于重演「同名 tag 静默指向另一份包」那个坑。
      **挑版本号时优先挑一个从未出现过的名字**，别贪「顺着 +1」的整齐。

  ⚠⚠ **从这一版起改用真密钥签名**（`keystore/YanSaki-13.jks`，别名 `yansaki-13`，
    口令在同目录被 gitignore 的 `signing.env`）。
    签名身份 = App 的身份 ⇒ **证书 SHA-256 与历史上那些 debug 签名的包不同**
    ⇒ 两者**不是同一个 App**：手机上装过旧版的，**必须先卸载**才能装这个
    （否则报 INSTALL_FAILED_UPDATE_INCOMPATIBLE）。这条没法绕过，只能提前说清。
    ⚠ 所以判据不是「签名成功」，而是 `verify.sh` 那条
      「**APK 的签名者证书 == 密钥库里的那张证书**」—— 换了密钥它就该红。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="top.yansaki.shed"
    android:versionCode="2"
    android:versionName="1.3">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- 页面里 @import 了 Google Fonts；离线时只是字体退化，不影响可用 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

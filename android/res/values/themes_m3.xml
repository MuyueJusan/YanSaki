<?xml version="1.0" encoding="utf-8"?>
<!--
  M3 Expressive 主题（浅色）

  ⚠ 仍然只挂 **framework** 主题（Theme.Material.Light.NoActionBar）——
     没有 AppCompat，所以 `Theme.MaterialComponents.*` / `Theme.Material3.*` 都用不了。
     M3 的观感靠下面这些颜色 + 自写的组件样式实现，不靠主题继承。

  ⚠ `colorAccent` / `colorControlActivated` 必须指到 primary：
     框架自带的 EditText 光标、SeekBar 滑块、Switch 都用这两个属性取色，
     不设的话它们在青绿色界面里会是系统默认的紫色 —— 一眼就看出是拼的。
-->
<resources>
    <style name="Theme.YS.Expressive" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorControlActivated">@color/md_primary</item>
        <item name="android:colorControlHighlight">@color/md_ripple</item>
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:textColorHighlight">@color/md_primary_container</item>

        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
